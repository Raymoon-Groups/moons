# Copy to .env for local overrides
# Physical device: use your PC's LAN IP, e.g. http://192.168.1.5:3001/api/v1
# Android emulator default is handled in lib/config.ts (10.0.2.2)
# Laptop browser preview can use localhost
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Same Google OAuth Web client ID as apps/web (required for Expo Go on phone)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Cloud Console (Web OAuth client → Authorized redirect URIs):
# - Website only: https://moonsjob.com/api/auth/callback/google (or your web callback)
# - Do NOT add exp:// URIs — Google rejects them on Web clients
#
# For Google sign-in on the native phone app (dev/production build, NOT Expo Go):
# 1. Create an Android OAuth client: package com.moonsjob.app + your debug SHA-1 fingerprint
# 2. (iOS) Create an iOS OAuth client: bundle com.moonsjob.app
# 3. Set the client IDs below, then run: npx expo run:android (or run:ios)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
